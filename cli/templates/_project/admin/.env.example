# Copy to admin/.env. Next environment overrides (.env.local etc.) take precedence.
PORT=3000

# Next server-only API URL used for runtime mode probes and development
# rewrites. The loopback default is only valid when API and web share a host;
# set a service URL such as http://api:8080 on the web container at runtime.
AGINEX_API_INTERNAL_URL=http://127.0.0.1:8080

# Compiled into browser assets by `next build`. Leave empty for same-origin
# `/api/v1` routing; set an absolute API origin only for a split-origin build.
NEXT_PUBLIC_API_URL=
