# Runtime and HTTP
AGINEX_ENV=development
AGINEX_HTTP_ADDRESS=:8080
AGINEX_API_PUBLIC_URL=http://localhost:8080
AGINEX_WEB_ORIGINS=http://localhost:3000
AGINEX_TRUSTED_PROXIES=
AGINEX_HTTP_MAX_BODY_BYTES=12582912
AGINEX_HTTP_MAX_HEADER_BYTES=1048576
AGINEX_HTTP_MAX_HEADER_COUNT=100
AGINEX_HTTP_READ_HEADER_TIMEOUT=5s
AGINEX_HTTP_READ_TIMEOUT=15s
AGINEX_HTTP_WRITE_TIMEOUT=30s
AGINEX_HTTP_IDLE_TIMEOUT=60s
AGINEX_HTTP_SHUTDOWN_GRACE_PERIOD=10s

# Database
# Inject a different value for each deployed process. The migrate job needs a
# DDL-capable role; API/worker roles must not own the schema or audit_logs and
# must have only SELECT/INSERT (never UPDATE/DELETE/TRUNCATE/DDL) on audit_logs.
AGINEX_DATABASE_DRIVER=sqlite
AGINEX_DATABASE_DSN=data/aginex.db

# Browser session and CSRF protection. The three protocol names are fixed by
# the published OpenAPI contract and cannot be overridden. The example
# credentials below are accepted for development but rejected in production.
AGINEX_SESSION_SECRET=replace-with-at-least-32-random-bytes
AGINEX_SESSION_COOKIE=aginex_session
AGINEX_SESSION_TTL=24h
AGINEX_SESSION_SECURE=false
AGINEX_SESSION_SAME_SITE=lax
AGINEX_CSRF_COOKIE=aginex_csrf
AGINEX_CSRF_HEADER=X-CSRF-Token

# Shared, database-backed request controls
AGINEX_RATE_LIMIT_LOGIN_LIMIT=10
AGINEX_RATE_LIMIT_LOGIN_WINDOW=5m
AGINEX_RATE_LIMIT_UPLOAD_LIMIT=120
AGINEX_RATE_LIMIT_UPLOAD_WINDOW=1m
AGINEX_RATE_LIMIT_SENSITIVE_LIMIT=300
AGINEX_RATE_LIMIT_SENSITIVE_WINDOW=1m
AGINEX_IDEMPOTENCY_DRIVER=database
AGINEX_IDEMPOTENCY_LEASE_DURATION=30s
AGINEX_IDEMPOTENCY_TTL=24h

# Durable jobs. The worker and production FilesModule require postgres, which
# also requires AGINEX_DATABASE_DRIVER=postgres.
AGINEX_JOBS_DRIVER=disabled
AGINEX_JOBS_WORKER_ID=aginex-worker
AGINEX_JOBS_POLL_INTERVAL=1s
AGINEX_JOBS_LEASE_DURATION=1m
AGINEX_JOBS_CONCURRENCY=4

# Explicit administrator bootstrap; remove these from normal runtime
# configuration. The example password is rejected when AGINEX_ENV=production.
AGINEX_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
AGINEX_BOOTSTRAP_ADMIN_PASSWORD=change-me-before-production

# Object storage
AGINEX_STORAGE_DRIVER=local
AGINEX_STORAGE_LOCAL_ROOT=data/uploads
AGINEX_STORAGE_BUCKET=
AGINEX_STORAGE_REGION=
AGINEX_STORAGE_ENDPOINT=
AGINEX_STORAGE_ACCESS_KEY_ID=
AGINEX_STORAGE_ACCESS_KEY_SECRET=

# Compiled into browser assets by `next build`; use the API origin, without /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:8080
